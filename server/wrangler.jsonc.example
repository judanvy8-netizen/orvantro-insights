{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orvantro-insights-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../public_assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "orvantro-insights",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "AUTH_PROVIDER": "github",
    "AUTH_ORIGIN": "https://REPLACE_WITH_ACTUAL_WORKER_HOST",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_REGISTERED_OAUTH_CLIENT_ID",
    "AUTH_GITHUB_OWNER_ID": "REPLACE_WITH_OWNER_NUMERIC_GITHUB_ID",
    "PUBLIC_STATS_ENABLED": "false"
  },
  "triggers": { "crons": ["15 * * * *"] },
  "observability": { "enabled": false }
}
